{
  "name": "@pearl.com/pearl-widget-vue",
  "version": "1.0.0",
  "description": "Vue component wrapper for the Pearl Widget iframe",
  "author": "Pearl.com",
  "license": "MIT",
  "homepage": "https://www.pearl.com/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pearl-com/pearl-widget.git",
    "directory": "vue-pearl-widget/pearl-widget"
  },
  "bugs": {
    "url": "https://github.com/Pearl-com/pearl-widget/issues"
  },
  "keywords": ["pearl", "widget", "vue", "iframe", "chat"],
  "main": "./dist/pearl-widget-vue.umd.js",
  "module": "./dist/pearl-widget-vue.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pearl-widget-vue.es.js",
      "require": "./dist/pearl-widget-vue.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vue": "^3.3.0",
    "vue-tsc": "^2.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
